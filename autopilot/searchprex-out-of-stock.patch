 WP_TEST_URL_PUBLIC=
 WP_TEST_USERNAME=
 WP_TEST_APP_PASSWORD=
+
+# -----------------------------------------------------------------------------
+# MSO autopilot quality gate (optional — all default to ON)
+# -----------------------------------------------------------------------------
+# Read by lib/autopilot/quality-gate.ts before anything is spent on a product,
+# so a page that cannot convert costs no Gemini call, no Indexing API slot and
+# no crawl budget. A product that fails is PARKED, not retired: every run puts
+# every 'skipped_gate' row back in the queue before it picks its batch, so a
+# product returns on its own once the reason it failed goes away.
+#
+# Set to "false" to switch a requirement off. NOTE: only "true" and "1" count as
+# on, so any typo ("False", "yes", "TRUE") reads as OFF.
+#
+# NicheSEO Pro runs the identical rules in server/mso-quality-gate.ts against
+# the same catalogue and the same queue. Change a flag in BOTH or the two
+# engines will fight: one publishes a product the other keeps parking.
+
+# Require at least one photograph. Keep this on — a product page with no image
+# looks broken and Google has no reason to index it.
+GATE_REQUIRE_IMAGE=true
+
+# Require the product to be in stock.
+# Set to false to publish out-of-stock products too. They still convert on
+# long-tail and carry internal links, and INDEX_OUT_OF_STOCK below keeps them
+# out of the Indexing API so the crawled-not-indexed pile does not grow.
+GATE_REQUIRE_IN_STOCK=true
+
+# Require a non-zero price.
+GATE_REQUIRE_PRICE=true
+
+# Require product attributes (steel, blade length, lock…) — the specs table is
+# the only part of the page that is not duplicated from the wholesale feed.
+GATE_REQUIRE_ATTRIBUTES=true
+GATE_MIN_ATTRIBUTES=1
+
+# Submit out-of-stock pages to the Google Indexing API as well.
+# Default (unset/false): out-of-stock products are published and left
+# crawlable, but Google is not asked to index them — the queue row lands on
+# 'published_not_submitted'. Only turn this on if the indexed ratio is healthy.
+INDEX_OUT_OF_STOCK=false
