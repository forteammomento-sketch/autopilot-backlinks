# ── Engines ──────────────────────────────────────────────────────────────────
# Perplexity Sonar — https://docs.perplexity.ai
PERPLEXITY_API_KEY=

# OpenAI Responses API with the web_search tool
OPENAI_API_KEY=

# Gemini, with Google Search grounding
GEMINI_API_KEY=

# Google AI Overviews and Bing's answer box have no official API. Both come
# through a SERP vendor, billed per query on top of the engine cost.
SERPAPI_API_KEY=
# Bing's answer box shares retrieval with Copilot but is not the Copilot app,
# so it is off by default and labelled "Bing AI answers" wherever it is shown.
# SEARCHPREX_ENABLE_BING=1

# ── Shopify deploy target ────────────────────────────────────────────────────
# Used when the project's cms_kind is 'shopify'. A write here goes to the LIVE
# storefront — there is no draft and no pull request, so the plan is shown
# before it is applied and the rollback snapshot is stored before any write.
#
# SHOPIFY_SHOP is the myshopify domain, not the customer-facing one.
# The token needs read_products, write_products and write_themes.
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=

# ── Headless rendering ───────────────────────────────────────────────────────
# Optional. Without it, js_only is not reported rather than guessed at.
# Install with `npm i -D playwright`.
# PLAYWRIGHT_CHROMIUM_PATH=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Leave unset and the dashboard runs on fixtures, which is what a fresh clone
# should do. Set both and it reads live data.
#
# The service-role key bypasses RLS, so it is server-only and every query in
# lib/data/supabase.ts filters by project_id explicitly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEARCHPREX_PROJECT_ID=

# ── Deploy target ────────────────────────────────────────────────────────────
# Without these, Deploy builds the plan and shows it but pushes nothing.
SEARCHPREX_GITHUB_TOKEN=
SEARCHPREX_GITHUB_OWNER=
SEARCHPREX_GITHUB_REPO=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# POST /api/jobs/measure and /api/jobs/remeasure, with
# `Authorization: Bearer $SEARCHPREX_JOB_SECRET`. The endpoint spends money, so
# it refuses every request until this is set.
SEARCHPREX_JOB_SECRET=

# Hard ceiling on engine calls per run. A 60-prompt, 2-engine, 3-repeat run is
# 360 calls; the default leaves headroom without leaving the bill open-ended.
SEARCHPREX_CALL_BUDGET=600

# ── Google Search Console ────────────────────────────────────────────────────
# Optional. Without it, prompts are seeded from the catalogue alone — inferred
# demand rather than measured demand, which is worth less but is not nothing.
#
# Preferred: connect from the Settings screen. The consent flow stores an
# encrypted refresh token and lets the customer pick their property and revoke
# access themselves.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public origin. Google matches the redirect URI exactly, so it is derived
# from this one value rather than from the incoming request — a request-derived
# URI changes with the host header and stops matching.
SEARCHPREX_BASE_URL=

# Required before any credential can be stored. 32 bytes:
#   openssl rand -base64 32
# Without it the connection is refused rather than saved in plaintext.
SEARCHPREX_ENCRYPTION_KEY=

# Fallback for a single-project deployment with no consent flow. GSC_SITE_URL
# must match the property exactly: `sc-domain:example.com` for a domain
# property, `https://www.example.com/` for a URL-prefix one. They are different
# properties with different data, and the wrong one returns 403.
GSC_SITE_URL=
GOOGLE_REFRESH_TOKEN=

# ── Prompt generation ────────────────────────────────────────────────────────
# MAX_PROMPTS=60      # the biggest recurring cost lever; 60 x 2 engines x 3 = 360 calls/run
# MAX_PAGES=60        # crawl depth for seed extraction

# ── Smoke-script overrides ───────────────────────────────────────────────────
# ENGINE=openai
# MODEL=sonar-pro
# Older accounts only accept the preview tool name:
# OPENAI_TOOL_TYPE=web_search_preview
